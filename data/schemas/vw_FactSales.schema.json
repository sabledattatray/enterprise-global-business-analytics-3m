{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vw_FactSalesSchema",
  "description": "Schema contract for the 19 reporting columns in dbo.vw_FactSales",
  "type": "object",
  "properties": {
    "record_id": { "type": "integer" },
    "order_id": { "type": "string" },
    "transaction_id": { "type": "string" },
    "ProductKey": { "type": "integer" },
    "GeographyKey": { "type": "integer" },
    "order_date": { "type": "string", "format": "date" },
    "quantity": { "type": "integer", "minimum": 1, "maximum": 10 },
    "unit_price": { "type": "number" },
    "discount_pct": { "type": "number", "minimum": 0, "maximum": 25 },
    "revenue": { "type": "number" },
    "cost": { "type": "number" },
    "profit": { "type": "number" },
    "tax_amount": { "type": "number" },
    "currency": { "type": "string", "maxLength": 3 },
    "order_status": { "type": "string", "enum": ["Delivered", "Shipped", "Processing", "Cancelled"] },
    "payment_status": { "type": "string", "enum": ["Paid", "Pending", "Failed"] },
    "sales_channel": { "type": "string", "enum": ["Online", "Direct", "Partner", "Retail"] },
    "planned_delivery_date": { "type": ["string", "null"], "format": "date" },
    "actual_delivery_date": { "type": ["string", "null"], "format": "date" }
  },
  "required": [
    "record_id",
    "order_id",
    "transaction_id",
    "ProductKey",
    "GeographyKey",
    "order_date",
    "quantity",
    "unit_price",
    "discount_pct",
    "revenue",
    "cost",
    "profit",
    "tax_amount",
    "currency",
    "order_status",
    "payment_status",
    "sales_channel"
  ]
}
